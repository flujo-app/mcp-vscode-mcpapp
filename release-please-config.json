{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.packages[0].version"
        },
        {
          "type": "json",
          "path": "src/bridge-extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "src/app/main.ts"
        },
        {
          "type": "generic",
          "path": "src/mcp/server.ts"
        },
        {
          "type": "generic",
          "path": "src/runtime/openvscode.ts"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    }
  }
}
